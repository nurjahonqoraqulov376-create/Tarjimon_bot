# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# Admin Telegram ID (/stats buyrug'i uchun). @userinfobot dan bilib olasiz.
ADMIN_ID=0

# SQLite bazasi yo'li.
# Lokalda: bot.db
# Railway'da: /data/bot.db  (volume mount path = /data)
DB_PATH=bot.db

# Ovozli xabar sozlamalari
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_BEAM=5
WHISPER_IDLE_UNLOAD_SEC=300
MAX_VOICE_SEC=120

# Bir foydalanuvchi so'rovlari orasidagi minimal vaqt (sekund)
THROTTLE_SEC=1.5
